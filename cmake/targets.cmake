file(READ "${ROOT_DIR}/CMakePresets.json" presets_json)
execute_process(
    COMMAND "${CMAKE_COMMAND}" --list-presets
    WORKING_DIRECTORY "${ROOT_DIR}"
    OUTPUT_VARIABLE host_presets
    ERROR_QUIET
)
string(REGEX MATCHALL "\"[^\"]+\"" host_presets "${host_presets}")
list(TRANSFORM host_presets REPLACE "\"" "")

string(JSON preset_count LENGTH "${presets_json}" configurePresets)
math(EXPR preset_last "${preset_count} - 1")
foreach(i RANGE ${preset_last})
    string(JSON name GET "${presets_json}" configurePresets ${i} name)
    set(preset_index_${name} ${i})
endforeach()

function(preset_value preset out)
    string(JSON value ERROR_VARIABLE missing GET "${presets_json}" configurePresets ${preset_index_${preset}} ${ARGN})
    if(missing)
        set(value "")
        string(JSON parents ERROR_VARIABLE orphan GET "${presets_json}" configurePresets ${preset_index_${preset}} inherits)
        if(NOT orphan)
            string(REGEX MATCHALL "[A-Za-z0-9_.-]+" parents "${parents}")
            foreach(parent IN LISTS parents)
                preset_value(${parent} value ${ARGN})
                if(NOT value STREQUAL "")
                    break()
                endif()
            endforeach()
        endif()
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(preset_environment preset)
    string(JSON parents ERROR_VARIABLE orphan GET "${presets_json}" configurePresets ${preset_index_${preset}} inherits)
    if(NOT orphan)
        string(REGEX MATCHALL "[A-Za-z0-9_.-]+" parents "${parents}")
        list(REVERSE parents)
        foreach(parent IN LISTS parents)
            preset_environment(${parent})
        endforeach()
    endif()
    string(JSON environment ERROR_VARIABLE none GET "${presets_json}" configurePresets ${preset_index_${preset}} environment)
    if(none)
        return()
    endif()
    string(JSON count LENGTH "${environment}")
    if(count EQUAL 0)
        return()
    endif()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON name MEMBER "${environment}" ${i})
        string(JSON type TYPE "${environment}" "${name}")
        string(JSON value GET "${environment}" "${name}")
        if(NOT type STREQUAL "STRING" OR value MATCHES "\\$[a-z]*{")
            message(FATAL_ERROR "Preset '${preset}' sets ${name} to something other than a literal string, which build.cmake cannot reproduce.")
        endif()
        set(ENV{${name}} "${value}")
    endforeach()
endfunction()

function(preset_problem preset out)
    set(problem "")
    if(NOT preset IN_LIST host_presets)
        preset_value(${preset} lhs condition lhs)
        preset_value(${preset} rhs condition rhs)
        if(lhs STREQUAL "\${hostSystemName}")
            set(problem "needs a ${rhs} host")
        else()
            set(problem "disabled on this host")
        endif()
    else()
        preset_value(${preset} generator generator)
        preset_value(${preset} compiler cacheVariables CMAKE_C_COMPILER)
        preset_value(${preset} linker cacheVariables CMAKE_EXE_LINKER_FLAGS)
        preset_value(${preset} sysroot cacheVariables CMAKE_SYSROOT)
        set(tools ${compiler})
        if(generator MATCHES "^Ninja")
            list(PREPEND tools ninja)
        endif()
        if(linker MATCHES "-fuse-ld=([a-z]+)")
            list(APPEND tools ld.${CMAKE_MATCH_1})
        endif()
        foreach(tool IN LISTS tools)
            find_program(path_${tool} ${tool} NO_CACHE)
            if(NOT path_${tool})
                set(problem "${tool} not found")
                break()
            endif()
        endforeach()
        if(problem STREQUAL "" AND sysroot AND NOT IS_DIRECTORY "${sysroot}")
            set(problem "${sysroot} not found")
        endif()
    endif()
    set(${out} "${problem}" PARENT_SCOPE)
endfunction()

set(TARGETS "")
set(TARGETS_AVAILABLE "")
set(width 0)
foreach(i RANGE ${preset_last})
    string(JSON name GET "${presets_json}" configurePresets ${i} name)
    string(JSON hidden ERROR_VARIABLE ignored GET "${presets_json}" configurePresets ${i} hidden)
    if(hidden)
        continue()
    endif()
    list(APPEND TARGETS ${name})
    preset_problem(${name} TARGET_PROBLEM_${name})
    if(TARGET_PROBLEM_${name} STREQUAL "")
        list(APPEND TARGETS_AVAILABLE ${name})
    endif()
    string(LENGTH "${name}" length)
    if(length GREATER width)
        set(width ${length})
    endif()
endforeach()

list(LENGTH TARGETS total)
list(LENGTH TARGETS_AVAILABLE available)
math(EXPR unavailable "${total} - ${available}")
set(TARGETS_HELP "Available targets (${available} of ${total}):")
foreach(name IN LISTS TARGETS_AVAILABLE)
    string(APPEND TARGETS_HELP "\n  ${name}")
endforeach()
string(APPEND TARGETS_HELP "\n\nUnavailable targets (${unavailable} of ${total}):")
foreach(name IN LISTS TARGETS)
    if(NOT name IN_LIST TARGETS_AVAILABLE)
        string(LENGTH "${name}" length)
        math(EXPR gap "${width} - ${length} + 2")
        string(REPEAT " " ${gap} pad)
        string(APPEND TARGETS_HELP "\n  ${name}${pad}${TARGET_PROBLEM_${name}}")
    endif()
endforeach()